meta {
  name: Documentation - Swagger UI
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/docs
  body: none
  auth: basic
}

auth:basic {
  username: {{demoUsername}}
  password: {{demoPassword}}
}

tests {
  test("renders the protected Swagger UI", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("content-type")).to.contain("text/html");
    expect(res.getBody()).to.contain("Swagger UI");
  });
}

